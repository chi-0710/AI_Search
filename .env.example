# ============================================================
# AI Search Agent 环境变量示例
#
# 使用方式：
# 1. 复制本文件：
#       cp .env.example .env
#
# 2. 在 .env 中填写真实密钥
#
# 3. 不要把 .env 提交到 GitHub
# ============================================================


# ============================================================
# 应用基础配置
# ============================================================

APP_NAME=AI_Search
APP_ENV=development
APP_DEBUG=true

LOG_LEVEL=INFO

DEFAULT_LANGUAGE=zh-CN
DEFAULT_RESEARCH_TYPE=deep_report


# ============================================================
# 研究任务限制
# ============================================================

# Planner 最少生成的研究问题数量
RESEARCH_MIN_QUESTIONS=3

# Planner 最多生成的研究问题数量
RESEARCH_MAX_QUESTIONS=5

# 单个任务默认最多使用的来源数量
RESEARCH_MAX_SOURCES=20

# 单任务最大并发数
RESEARCH_MAX_CONCURRENCY=5

# 整个研究任务最大运行时间，单位：秒
RESEARCH_TASK_TIMEOUT_SECONDS=300

# Reviewer 最大修订次数
# 当前阶段暂未实现
RESEARCH_MAX_REVISIONS=2


# ============================================================
# 大语言模型配置
# ============================================================

LLM_PROVIDER=deepseek

# 推荐默认使用：
# deepseek-v4-flash：速度较快，适合 Planner 和一般报告生成
# deepseek-v4-pro：能力更强，适合复杂深度报告
LLM_MODEL=deepseek-v4-flash

# 研究任务建议保持较低温度
LLM_TEMPERATURE=0.2

# 单次模型请求超时时间，单位：秒
LLM_TIMEOUT_SECONDS=60

# 模型请求失败后的最大重试次数
LLM_MAX_RETRIES=2

# 单次最大输出 Token
LLM_MAX_TOKENS=8192


# ============================================================
# DeepSeek Provider
# ============================================================

# 真实 API Key 只写入 .env
DEEPSEEK_API_KEY=your_deepseek_api_key

# DeepSeek API 地址
DEEPSEEK_API_BASE=https://api.deepseek.com/v1


# ============================================================
# Web Search Tool
# 当前尚未确定具体搜索 Provider
# ============================================================

# 后续可选：tavily、serper、bing、brave 等
WEB_SEARCH_PROVIDER=tavily

WEB_SEARCH_API_KEY=your_web_search_api_key

# 单次搜索请求超时时间，单位：秒
WEB_SEARCH_TIMEOUT_SECONDS=20

# 搜索失败后的最大重试次数
WEB_SEARCH_MAX_RETRIES=2

# 单次搜索默认返回数量
WEB_SEARCH_MAX_RESULTS=10


# ============================================================
# GitHub Research Tool
# 当前阶段暂未使用
# ============================================================

GITHUB_TOKEN=


# ============================================================
# 论文检索配置
# 当前阶段暂未使用
# ============================================================

# 后续可选：openalex、arxiv、semantic_scholar
PAPER_SEARCH_PROVIDER=openalex

PAPER_SEARCH_API_KEY=


# ============================================================
# LangSmith / Trace
# 当前阶段默认关闭
# ============================================================

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AI_Search


# ============================================================
# 以下属于后续迭代
# ============================================================

# PostgreSQL
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_search

# Redis
# REDIS_URL=redis://localhost:6379/0